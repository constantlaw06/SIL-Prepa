// Base locale SQLite. Pour un déploiement, remplacer provider par "postgresql"
// et pointer DATABASE_URL sur la base hébergée : le reste du schéma est portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Modèles attendus par Auth.js (adaptateur Prisma) ---

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  results       QuizResult[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Progression de révision ---

model QuizResult {
  id       String   @id @default(cuid())
  userId   String
  theme    String
  score    Int
  gradable Int
  pct      Int
  at       DateTime
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Une série est identifiée par son thème et son horodatage : rejouer une
  // synchronisation ne crée donc pas de doublon.
  @@unique([userId, theme, at])
  @@index([userId])
}
