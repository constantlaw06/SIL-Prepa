# Copier ce fichier en .env.local puis renseigner les valeurs.
# .env.local n'est jamais versionné.

# Base Postgres (ex. Neon, gratuit). En local comme en production : voir
# README > Déploiement. Format : postgresql://user:motdepasse@hote/base?sslmode=require
DATABASE_URL=""

# Secret de signature des sessions. Générer avec : npx auth secret
AUTH_SECRET=""

# En auto-hébergement (hors Vercel), un build de production refuse les requêtes
# dont l'hôte n'est pas déclaré. Renseigner l'un des deux :
#   - l'URL publique de l'application,
#   - ou AUTH_TRUST_HOST si l'application est derrière un proxy de confiance.
# En développement (npm run dev), rien de tout cela n'est nécessaire.
# AUTH_URL="https://exemple.fr"
# AUTH_TRUST_HOST="true"

# Google Cloud Console > API et services > Identifiants > ID client OAuth 2.0
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Meta for Developers > Mon application > Connexion Facebook > Paramètres
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
